# ─────────────────────────────────────────────────────────────────────────────
# AI HMW Platform — 環境變數範本
# 複製成 .env.local（本機），或填入雲端平台的環境變數設定。
# .env.local 已列入 .gitignore，絕對不要 commit。
# ─────────────────────────────────────────────────────────────────────────────

# ═══ 必填：Supabase ═══════════════════════════════════════════════════════════
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon public key（前端可見）
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role key（只給 server / worker，絕不可暴露到前端）
NEXT_PUBLIC_SUPABASE_BUCKET=uploads             # Storage bucket 名稱，需在 Supabase 建立並設為 Public

# ═══ 必填：Claude（Anthropic API，分析引擎唯一的 LLM 來源）═════════════════════
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5               # 未填預設 claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=32768                      # 單次回覆 token 上限（未填預設 8192；長逐字稿/collective 步驟建議調高，8192 容易被截斷）

# ═══ 目前未啟用：Azure OpenAI（lib/llm/azureOpenAI.js 保留但分析引擎已改走 Claude）═══
# AZURE_OPENAI_ENDPOINT=https://xxxx.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_MAX_COMPLETION_TOKENS=32768

# ═══ 選填：Worker 併發與限流（未填即用預設值）══════════════════════════════════
WORKER_POLL_INTERVAL_MS=5000     # worker 輪詢資料庫的間隔（毫秒）
MAX_CONCURRENT_ANALYSES=15       # 同時執行的分析任務數
MAX_CONCURRENT_FILES=3           # 同時解析的檔案數
ANALYSIS_CONCURRENCY=3           # 單一分析內同時處理的檔案數
API_MAX_RPM=200                  # LLM 呼叫每分鐘上限（rate limiter）
# WORKER_MODE=job                # 設為 job 時 worker 跑完一輪就結束（給 Cloud Run Job 用）；常駐請不要設

# ═══ 選填：Prompt 內容長度截斷（字元數）═════════════════════════════════════
TRANSCRIPT_MAX_CHARS=40000       # 單份逐字稿注入 prompt 的上限
PREV_RESULTS_MAX_CHARS=60000     # 前序步驟結果注入 prompt 的上限
ATTACHMENT_MAX_CHARS=20000       # 步驟附件注入 prompt 的上限

# ═══ 目前未啟用（程式碼保留但沒有走到）═══════════════════════════════════════
# GEMINI_API_KEY=                # lib/llm/gemini.js 存在，但分析引擎目前只走 Azure
# GEMINI_MAX_RPM=
# RESEND_API_KEY=                # pages/api/contact.js 的寄信程式碼被註解，聯絡表單目前只印 log
