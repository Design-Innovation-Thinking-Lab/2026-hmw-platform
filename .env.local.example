# ─────────────────────────────────────────────────────────────────────────────
# AI HMW Platform — 環境變數範本
# 複製成 .env.local（本機），或填入雲端平台的環境變數設定。
# .env.local 已列入 .gitignore，絕對不要 commit。
# ─────────────────────────────────────────────────────────────────────────────

# ═══ 必填：Supabase ═══════════════════════════════════════════════════════════
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon public key（前端可見）
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # service_role key（只給 server / worker，絕不可暴露到前端）
NEXT_PUBLIC_SUPABASE_BUCKET=uploads             # Storage bucket 名稱，需在 Supabase 建立，必須是私人 bucket（用 signed URL 讀寫）

# ═══ 選填：網站網址 ═══════════════════════════════════════════════════════════
# 管理員寄「重設密碼信」時，信裡連結要回到的網站網址（例如 https://xxx.vercel.app）。
# 未填時用請求的 Host。要和 Supabase Auth → URL Configuration 的 Redirect URLs 一致。
SITE_URL=

# ═══ 必填：Claude（Anthropic API，分析引擎唯一的 LLM 來源）═════════════════════
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5               # 未填預設 claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=32768                      # 單次回覆 token 上限（未填預設 8192；長逐字稿/collective 步驟建議調高，8192 容易被截斷）

# ═══ 目前未啟用：Azure OpenAI（lib/llm/azureOpenAI.js 保留但分析引擎已改走 Claude）═══
# AZURE_OPENAI_ENDPOINT=https://xxxx.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_MAX_COMPLETION_TOKENS=32768

# ═══ 必填（正式環境）：Vercel Cron ═══════════════════════════════════════════
# Vercel Cron 每分鐘呼叫 /api/cron/worker 跑一輪分析，會帶 Authorization: Bearer <CRON_SECRET>。
# 在 Vercel 的 Environment Variables 設定（老師已設定）。本機要手動測試時才需要。
CRON_SECRET=

# ═══ 選填：分析排程（未填即用預設值）═══════════════════════════════════════════
CRON_MAX_DURATION_SECONDS=800    # 一輪最長幾秒，要和 vercel.json 的 maxDuration 一致
CRON_MIN_REMAINING_SECONDS=300   # 剩下少於這個秒數就不開始新的一步、留給下一輪（會自動依最近「最長的一步」調高）
CRON_MAX_RUNS_PER_TICK=3         # 一輪最多同時跑幾個分析
CRON_MAX_CRASHES=2               # 同一個分析被中途砍掉超過幾次就標成失敗
ANALYSIS_CONCURRENCY=3           # 單一分析內同時處理的檔案數
API_MAX_RPM=200                  # LLM 呼叫每分鐘上限（rate limiter，只在同一輪內有效）
WORKER_POLL_INTERVAL_MS=5000     # 只給本機 npm run worker 用：每輪之間等幾毫秒
# WORKER_MODE=job                # 只給本機 npm run worker 用：跑一輪就結束

# ═══ 選填：Prompt 內容長度截斷（字元數）═════════════════════════════════════
TRANSCRIPT_MAX_CHARS=40000       # 單份逐字稿注入 prompt 的上限
PREV_RESULTS_MAX_CHARS=60000     # 前序步驟結果注入 prompt 的上限
ATTACHMENT_MAX_CHARS=20000       # 步驟附件注入 prompt 的上限

# ═══ 目前未啟用（程式碼保留但沒有走到）═══════════════════════════════════════
# GEMINI_API_KEY=                # lib/llm/gemini.js 存在，但分析引擎目前只走 Azure
# GEMINI_MAX_RPM=
# RESEND_API_KEY=                # pages/api/contact.js 的寄信程式碼被註解，聯絡表單目前只印 log
